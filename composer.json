{
    "name": "elliottlawson/source-laravel",
    "description": "Laravel filesystem driver for source, the Git-backed file store.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filesystem",
        "flysystem",
        "git",
        "storage",
        "versioning"
    ],
    "support": {
        "source": "https://github.com/elliottlawson/source-laravel",
        "issues": "https://github.com/elliottlawson/source-laravel/issues"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "league/flysystem": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Source\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Source\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Source\\SourceServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
